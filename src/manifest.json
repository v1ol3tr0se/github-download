{
	"manifest_version": 3,
	"name": "GitHub — DOWNLOAD",
	"version": "1.0.2",
	"description": "A big ass DOWNLOAD button on every GitHub repo that grabs the right file for your system.",
	"browser_specific_settings": {
		"gecko": {
			"id": "github-download@v1ol3tr0se",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"host_permissions": ["https://github.com/*"],
	"content_scripts": [
		{
			"matches": ["https://github.com/*"],
			"js": ["pick.js", "content.js"],
			"css": ["big.css"],
			"run_at": "document_idle"
		}
	]
}
